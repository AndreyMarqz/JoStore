@startuml
title JoStore - Visão de Implantação - Ambiente Atual de Desenvolvimento
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam componentStyle rectangle

node "Dispositivo do Cliente\n<<device>>\n0..*" as CustomerDevice #DCEBFF {
  artifact "Navegador Web\nChrome, Edge ou similar" as CustomerBrowser
}

node "Dispositivo do Administrador\n<<device>>\n0..*" as AdminDevice #DCEBFF {
  artifact "Navegador Web\nChrome, Edge ou similar" as AdminBrowser
}

cloud "Rede local / Internet\nHTTP" as Network #F2F2F2

node "Máquina de Desenvolvimento JoStore\n<<node>>\nWindows" as Host #FFFDF1 {
  node "Servidor Web de Desenvolvimento\n<<web server>>\nVite" as WebServer {
    artifact "Frontend JoStore\nReact + TypeScript\nporta 5173" as Frontend
  }

  node "Servidor de Aplicação\n<<application server>>\nJava 21 + Spring Boot" as ApplicationServer {
    artifact "API REST JoStore\nporta 8080\n/api/v1" as Backend
  }

  node "Docker Engine\n<<container runtime>>" as Docker {
    database "PostgreSQL 18\n<<database>>\nporta 5432\nbanco: jostore" as Database
    folder "Volume Docker\njostore_postgres_data" as Volume
  }
}

CustomerBrowser --> Network : Acesso à loja
AdminBrowser --> Network : Administração
Network --> WebServer : HTTP\nhttp://localhost:5173
WebServer --> ApplicationServer : HTTP + JSON\nREST /api/v1
ApplicationServer --> Database : JDBC/TCP 5432
Database --> Volume : Dados persistentes

note bottom of ApplicationServer
  O Spring Boot concentra regras de negócio,
  controllers, services, repositories e JPA/Hibernate.
end note

note bottom of Database
  O PostgreSQL executa em container Docker.
  Flyway cria e versiona o esquema do banco.
end note

note bottom of WebServer
  Em produção, o Vite de desenvolvimento será
  substituído por hospedagem estática ou servidor web.
end note
@enduml
